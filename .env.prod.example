# Copy to .env.prod and set strong values before deploying.

# Postgres (used by the db service)
POSTGRES_USER=homeshred
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=homeshred

# Backend connection (must match the POSTGRES_* values above; host = "db" service).
DATABASE_URL=postgresql+asyncpg://homeshred:change-me-strong-password@db:5432/homeshred
