# Async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://homeshred:homeshred@localhost:5434/homeshred

# Separate database used by the test suite (never the dev DB).
TEST_DATABASE_URL=postgresql+asyncpg://homeshred:homeshred@localhost:5434/homeshred_test

# Comma-separated CORS origins allowed in dev (FE dev server).
CORS_ORIGINS=http://localhost:3000

# Where progress photos + Piper TTS voices/cache are stored.
# MEDIA_DIR=media

# Voice-coach text-to-speech (Piper). Download the models with `make tts-voices`.
# If disabled or a model is missing, the app falls back to browser speech.
# TTS_ENABLED=true
# TTS_VOICE_EN=en_US-lessac-high
# TTS_LENGTH_SCALE=1.05
# TTS_VOICE_VI=vi_VN-vais1000-medium

# Optional higher-quality Vietnamese voice (F5-TTS). Needs the `f5` extras
# (uv pip install -e '.[f5]') + model (`make tts-f5`). Falls back to Piper if
# missing, so it is safe to leave on where the extras are installed.
# TTS_VI_ENGINE=piper        # set to "f5" to use the neural Vietnamese voice
# TTS_F5_DIR=media/tts/f5
# TTS_F5_SPEED=0.9
# TTS_F5_REF_AUDIO=ref.wav   # default: bundled VIVOS Southern-female clip (assets/ATTRIBUTION.md)
# TTS_F5_REF_TEXT=nếu thỉnh thoảng có vài ngày nghỉ người thụy điển thường ra đảo chơi.
